# Neon (Postgres). Una base para el producto y otra para las sesiones de Evolution.
# En el servicio de Railway usa la cadena con "-pooler" para DATABASE_URL y la directa para Evolution.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST-pooler.neon.tech/app?sslmode=require
EVOLUTION_DATABASE_URL=postgresql://USUARIO:CLAVE@HOST.neon.tech/evolution?sslmode=require

# Clave global de Evolution y token del webhook. Genera cada uno largo y aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
EVOLUTION_API_KEY=
WEBHOOK_TOKEN=
SESSION_SECRET=

# URL pública del servicio en Railway (después del primer despliegue)
PUBLIC_URL=http://localhost:8000

# Solo para desarrollo local sin Docker. En el contenedor, start.sh los deriva.
EVOLUTION_URL=http://localhost:8080
WEBHOOK_BASE_URL=http://localhost:8000

# Telegram (Fase 5)
TELEGRAM_BOT_TOKEN=

# Gemini (Fase 3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Respaldo si el principal está saturado (503) o limitado (429). Vacío = sin respaldo.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Zona horaria para interpretar "mañana a las 10"
TZ=America/La_Paz

# Moneda que se muestra junto a los montos de las ventas
CURRENCY=Bs

# Minutos de silencio antes de analizar una conversación
SILENCE_MINUTES=10

# Recordatorios (Fase 5)
REMINDER_INTERVAL_MIN=15
REMINDER_COOLDOWN_MIN=120
